              "id": "handoff-note",
              "type": "text",
              "x": 232,
              "y": 120,
              "w": 280,
              "h": 120,
              "data": {
                "text": "Good handoffs reduce phone calls, repeat visits, and the quiet loss of responsibility."
              }
