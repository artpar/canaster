              "id": "supervisor",
              "type": "text",
              "x": -108,
              "y": 92,
              "w": 268,
              "h": 124,
              "data": {
                "text": "Supervisor\nResolves ambiguity, approves exceptions, and decides when a field note becomes a policy change."
              }
