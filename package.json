{
  "name": "canaster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:cloud": "VITE_DAPTIN_ENDPOINT=https://api.canaster.in VITE_CANASTER_STORAGE_MODE=daptin vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "daptin:up": "docker compose -f docker-compose.daptin.yml up -d",
    "daptin:down": "docker compose -f docker-compose.daptin.yml down",
    "daptin:logs": "docker compose -f docker-compose.daptin.yml logs -f daptin",
    "daptin:smoke": "node scripts/daptin-smoke.mjs",
    "daptin:smoke:local": "DAPTIN_SMOKE_ENDPOINT=http://localhost:6336 DAPTIN_SMOKE_CLI_CONFIG=.tmp/daptin/local-site-cli.yaml node scripts/daptin-smoke.mjs",
    "daptin:check:cloud": "curl -fsS 'https://api.canaster.in/api/world?page%5Bsize%5D=1' >/dev/null",
    "fixture:nested": "node scripts/generate-nested-grid-fixture.mjs",
    "profile:nested": "node scripts/profile-nested-grid-fixture.mjs"
  },
  "dependencies": {
    "daptin-client": "^0.7.12",
    "dexie": "^4.4.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "daptin-client": {
      "axios": "^1.18.0"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
