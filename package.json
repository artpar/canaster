{
  "name": "canaster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "VITE_DAPTIN_ENDPOINT=http://canaster.local:6336 VITE_CANASTER_PUBLIC_ORIGIN=http://canaster.local:5173 VITE_CANASTER_STORAGE_MODE=daptin vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:cloud": "VITE_DAPTIN_ENDPOINT=https://api.canaster.in VITE_CANASTER_STORAGE_MODE=daptin vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "verify:daptin-boundary": "bash scripts/check-daptin-client-boundary.sh",
    "verify:fast": "npm run typecheck && npm run verify:daptin-boundary && git diff --check",
    "verify:static": "npm run verify:fast && npm audit --omit=dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "daptin:local:schema": "scripts/prepare-local-daptin-schema.sh",
    "daptin:up": "npm run daptin:local:schema && docker compose -f docker-compose.daptin.yml up -d",
    "daptin:down": "docker compose -f docker-compose.daptin.yml down",
    "daptin:logs": "docker compose -f docker-compose.daptin.yml logs -f daptin",
    "daptin:provision-share-template": "scripts/provision-canaster-share-template.sh"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/roboto-flex": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "daptin-client": "^0.7.12",
    "dexie": "^4.4.3",
    "dompurify": "^3.4.11",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.2.0",
    "pdfjs-dist": "6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "daptin-client": {
      "axios": "^1.18.0"
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.6.3",
    "vite": "^8.0.16"
  }
}
